# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/buckalew_financial_db"

# Email Service Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@domain.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@buckalewfinancial.com"
ADMIN_EMAIL="admin@buckalewfinancial.com"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-min-32-characters"

# Optional: Insurance API Integration
INSURANCE_API_KEY="your-insurance-api-key"
INSURANCE_API_URL="https://api.insurance-provider.com"

# Optional: Analytics
GOOGLE_ANALYTICS_ID="GA-XXXX-XXXX"
GTM_ID="GTM-XXXX"

# Optional: External Services
HUBSPOT_API_KEY="your-hubspot-api-key"
CALENDLY_URL="https://calendly.com/your-account"

# Development Only
NODE_ENV="development"
