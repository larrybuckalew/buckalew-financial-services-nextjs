// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String      @id @default(cuid())
  email             String      @unique
  name              String
  password          String
  hashedPassword    String?
  phone             String?
  address           String?
  preferences       Json?       @default("{}")
  roleId            String      
  role              Role        @relation(fields: [roleId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  lastLogin         DateTime?
  isActive          Boolean     @default(true)
  
  // Two-factor auth
  twoFactorEnabled  Boolean     @default(false)
  twoFactorSecret   String?
  backupCodes       String[]

  // Password reset
  resetToken        String?
  resetTokenExpiry  DateTime?

  // Relations
  quotes            Quote[]
  auditLogs         AuditLog[]
  sessions          Session[]
  accounts          Account[]
  blogPosts         BlogPost[]
  agentAppointments Appointment[] @relation("AgentAppointments")
  clientAppointments Appointment[] @relation("ClientAppointments")
}

model Role {
  id          String    @id @default(cuid())
  name        String    @unique
  permissions String[]
  users       User[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id           String    @id @default(cuid())
  action       String
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  details      String
  ipAddress    String
  resourceType String
  resourceId   String
  metadata     String?   // JSON string
  timestamp    DateTime  @default(now())
}

model SystemSettings {
  id                 Int      @id @default(1)
  siteName           String   @default("Buckalew Financial Services")
  contactEmail       String
  maintenanceMode    Boolean  @default(false)
  theme             String   @default("light")
  sessionTimeout    Int      @default(30) // minutes
  maxLoginAttempts  Int      @default(5)
  passwordPolicy    Json     @default("{\"minLength\":8,\"requireUppercase\":true,\"requireNumbers\":true,\"requireSpecialChars\":true,\"expiryDays\":90}")
  emailSettings     Json     @default("{\"smtpHost\":\"\",\"smtpPort\":587,\"smtpUser\":\"\",\"smtpPassword\":\"\",\"senderName\":\"\",\"senderEmail\":\"\"}")
  notificationSettings Json  @default("{\"emailNotifications\":true,\"smsNotifications\":false,\"pushNotifications\":false}")
  backupSettings    Json     @default("{\"autoBackup\":true,\"backupFrequency\":\"daily\",\"retentionDays\":30}")
  updatedAt         DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Appointment {
  id        String    @id @default(cuid())
  agentId   String
  clientId  String
  startTime DateTime
  endTime   DateTime
  status    String    @default("PENDING") // e.g., PENDING, CONFIRMED, CANCELLED, COMPLETED
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  agent     User      @relation("AgentAppointments", fields: [agentId], references: [id])
  client    User      @relation("ClientAppointments", fields: [clientId], references: [id])
}

model Quote {
  id                String    @id @default(cuid())
  userId            String?
  user              User?     @relation(fields: [userId], references: [id])
  firstName         String
  lastName          String
  email             String
  phone             String
  zipCode           String
  insuranceType     String
  dateOfBirth       DateTime?
  gender            String?
  maritalStatus     String?
  tobacco           String?
  healthConditions  String?
  coverageAmount    String?
  currentCoverage   String?
  additionalNotes   String?
  status            String    @default("PENDING") // PENDING, CONTACTED, QUOTED, CONVERTED, CLOSED
  submittedAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model BlogPost {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  content      String    @db.Text
  excerpt      String
  coverImage   String?
  tags         String[]
  isPublished  Boolean   @default(false)
  readTime     Int?
  authorId     String
  author       User      @relation(fields: [authorId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  publishedAt  DateTime?
}
